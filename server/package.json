  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "mtproto:login": "ts-node -r tsconfig-paths/register scripts/telegram-mtproto-login.ts",
    "gen:secrets": "ts-node -r tsconfig-paths/register scripts/generate-secrets.ts",
    "migrate:deploy": "prisma migrate deploy",
    "lemon:test-webhook": "ts-node -r tsconfig-paths/register scripts/lemon-webhook-test.ts",
    "lemon:provision-plans": "ts-node -r tsconfig-paths/register scripts/lemon-provision-plans.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
