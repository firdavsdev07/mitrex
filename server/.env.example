# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mitrex?schema=public"

# App
PORT=5000
APP_URL=http://localhost:5000

# Reverse proxy (nginx/Cloudflare) ortida ishlaganda hop sonini kiriting (odatda 1).
# Proxy'siz to'g'ridan-to'g'ri ochiq serverda BO'SH qoldiring.
TRUST_PROXY=

# Refresh-token cookie domeni. Frontend va API bir xil parent domenning
# subdomenlarida bo'lsa (masalan app.example.com / api.example.com),
# ".example.com" qiling — shunda cookie ikkalasiga ham ko'rinadi va
# frontend middleware sessiya borligini oldindan bila oladi. Lokal devda
# (ikkalasi ham localhost, faqat porti farq qiladi) BO'SH qoldiring.
COOKIE_DOMAIN=

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Token/2FA-secret encryption (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Treat like JWT_SECRET — rotating it makes all stored OAuth tokens and 2FA
# secrets unreadable (users would need to reconnect platforms / re-enroll 2FA).
ENCRYPTION_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# YouTube OAuth (channel owner connects their OWN channel — enables
# per-video subscriber stats via yt-analytics.readonly; reuses
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above)
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:5000/youtube/oauth/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# Telegram MTProto (post-level stats: views per channel post)
# TELEGRAM_API_ID / TELEGRAM_API_HASH — free, from https://my.telegram.org (one per app, not per user).
# TELEGRAM_MTPROTO_SESSION — generated ONCE by running `pnpm mtproto:login` (see server/scripts/telegram-mtproto-login.ts)
# and pasting its printed session string here. This is a live login credential for a real Telegram
# account — treat it as secret as JWT_SECRET, never commit it. If unset, Telegram post-level sync is
# skipped (channel-level follower stats keep working via the bot token above).
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
TELEGRAM_MTPROTO_SESSION=

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5000/auth/github/callback

# Discord OAuth (Login)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:5000/auth/discord/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:5000/auth/facebook/callback

# Apple Sign In
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=path/to/private/key

# Resend (Email)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (redirect after OAuth)
FRONTEND_URL=http://localhost:3000

# Discord Bot (Platform stats)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_PLATFORM_REDIRECT_URI=http://localhost:5000/discord/callback

# Instagram + Facebook Pages (Meta Graph API — bitta OAuth oqimi)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/instagram/callback

# Threads. Meta'ning ALOHIDA API'si (graph.threads.net) — Instagram tokeni bu
# yerda ishlamaydi. Meta App Dashboard'da "Threads API" mahsulotini qo'shib,
# o'z App ID / Secret'ini oling.
THREADS_APP_ID=your-threads-app-id
THREADS_APP_SECRET=your-threads-app-secret
THREADS_REDIRECT_URI=http://localhost:5000/threads/callback

# Pinterest (API v5 — bepul, lekin standard access uchun app review kerak)
PINTEREST_APP_ID=your-pinterest-app-id
PINTEREST_APP_SECRET=your-pinterest-app-secret
PINTEREST_REDIRECT_URI=http://localhost:5000/pinterest/callback

# Reddit (no OAuth — public r/<subreddit>/about.json). Reddit rate-limits
# generic User-Agents aggressively; use the format platform:app-id:version
# (by /u/yourusername) as recommended by Reddit's API rules.
REDDIT_USER_AGENT=web:metrix-analytics:v1.0 (by /u/your_username)

# AI Provider (Azure OpenAI). Endpoint "/openai/v1" bilan tugaydigan yangi,
# versiyasiz API surface'i bo'lishi kerak (Azure AI Foundry resursi) — bunda
# api-version query parametri KERAK EMAS, hatto yuborilsa 400 qaytaradi.
# Bo'sh bo'lsa AI insights endpointlari 503 qaytaradi.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Redis. Navbat (BullMQ), kesh va rate-limit hisoblagichi shu yerda.
# Bo'sh qoldirilsa hammasi xotirada ishlaydi — bu FAQAT bitta nusxa
# ishlaganda to'g'ri. Prod'da (pm2 cluster / bir nechta server) shart.
REDIS_URL=redis://localhost:6379

# Rate-limit chegaralari (bitta IP uchun so'rovlar soni).
# short = 1 soniyada · medium = 10 soniyada · long = 1 daqiqada
# Bo'sh qoldirilsa: 10 / 50 / 200. Prod trafikka qarab oshiring.
# Eslatma: /track va /track/event o'z alohida (yumshoqroq) limitiga ega —
# qarang tracking.controller.ts.
RATE_LIMIT_SHORT=
RATE_LIMIT_MEDIUM=
RATE_LIMIT_LONG=

# Meta Webhook
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Admin (for pnpm seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# Sentry (error tracking). Bo'sh qoldirilsa SDK hech narsa yubormaydi (no-op) —
# lokal devda shart emas.
SENTRY_DSN=

# "production" / "staging" — Sentry'da muhitlarni ajratish uchun. Bo'sh
# qoldirilsa NODE_ENV ishlatiladi.
SENTRY_ENVIRONMENT=

# Deploy versiyasi (masalan git SHA) — xato qaysi relizda paydo bo'lganini
# ajratish uchun.
SENTRY_RELEASE=

# Tracing namunasi 0..1 oralig'ida (0.1 = so'rovlarning 10%i). Bo'sh bo'lsa
# prod'da 0.1, devda 0. Trafik o'sganda Sentry kvotasini tejash uchun
# pasaytiring.
SENTRY_TRACES_SAMPLE_RATE=

# To'lov provayderi hali ulanmagan — /billing/checkout hozircha 503
# qaytaradi ("to'lov tizimi sozlanmagan"). Free plan va bekor qilish
# provayder'siz ham lokal ishlaydi.
